@page "/Quiz"
@page "/Quiz/ThemaID={ThemaId:int}/CharacterID={CharacterId:int}/SpielerID={SpielerId:int}/QuizID={QuestionSetId:int}"
@using Schulprojekt.Services
@using Schulprojekt.Data
@using System.Text.RegularExpressions
@inject IQuestionService questionService
@inject IQuestionSetService questionSetService
@inject QuizStateService QuizStateService

@inject NotificationService NotificationService
@inject IQuestionSetProgressService QestionSetProgressService
@inject IWebHostEnvironment Env


<PageTitle>@pageTitle</PageTitle>
<h3>@pageTitle</h3>

@if (QuestionsList.Count <= 0)
{
    <h3>Loading...</h3>
}
else
{
    <RadzenDataList WrapItems="false" PageNumbersCount="10"
                    PageSize="1" ShowPagingSummary=true AllowPaging="true" @ref="dataList" Data="@QuestionsList" TItem="Question">
        <Template Context="x">
            <RadzenStack Orientation="Orientation.Horizontal" >
                <RadzenCard class="question-card" Style=@($"--bg-image:url('{BackgroundImage}')")>
                    <!-- (Questions) -->
                    <RadzenStack>
                        <RadzenRow JustifyContent="JustifyContent.Center">
                            <RadzenImage Path=@($"/images/Profil_Images/Profil_Image_{CharacterId}.png") Style="width: 100px; height: 100px; border-radius: 50%;" />
                        </RadzenRow>
                        <RadzenRow @key="x.Id">
                            <b>
                                @foreach (var part in SplitGapQuestionText(x.StartText))
                                {
                                    if (part.IsGap)
                                    {
                                        <RadzenTextBox Immediate="true"
                                                       Placeholder="Antwort hier eingeben..."
                                                       Value="@GetGapValue(x.Id, part.GapIndex)"
                                                       Change="@(value => GapTextEvaluation(value, x, part.GapIndex))"
                                                       Style="width: 42%; margin: 1% auto; background-color: #eaeaea;"
                                                        />
                                    }
                                    else
                                    {
                                        @part.Text
                                    }
                                }
                            </b>
                        </RadzenRow>
                    </RadzenStack>
                    <hr />
                    <!-- (Answers) -->
                    <RadzenStack Orientation="Orientation.Vertical" AlignItems="AlignItems.Start" JustifyContent="JustifyContent.Start" Gap="0.5rem" class="rz-p-sm-12">
                        @if (x.QuestionType == QuestionType.TF && !x.AllowsMultiple)
                        {
                            <!-- (Single Choice Answers) -->
                            <RadzenRadioButtonList @bind-Value=@x.selectedAnswer TValue="McAnswer" Change="@(value => SinglechoiceEvaluating(value, x))" Orientation="Orientation.Vertical">
                                <Items>
                                    @foreach (var antwort in x.McAnswers)
                                    {
                                        <RadzenRadioButtonListItem Text="@antwort.OptionText" Value="@antwort" />
                                    }
                                </Items>
                            </RadzenRadioButtonList>
                        }
                        else if (x.QuestionType == QuestionType.MC && x.AllowsMultiple)
                        {
                                <!-- (Multiple Choice Answers) -->
                            <RadzenCheckBoxList Value=@x.selectMultiAnswers TValue="McAnswer" Change="@((IEnumerable<McAnswer> value) => OnChangeMultipleChoice(x, value))" Orientation="Orientation.Vertical">
                                <Items>
                                    @foreach (var antwort in x.McAnswers)
                                    {
                                        <RadzenCheckBoxListItem Text="@antwort.OptionText" Value="@antwort" />
                                    }
                                </Items>
                            </RadzenCheckBoxList>
                        }
                        else if (x.QuestionType == QuestionType.GAP && x.AllowsMultiple)
                        {
                            <!-- (GapText Answers) -->
                            <!-- Gaps are loaded previously in the question, see method ReplaceGapsWithTextfields(Question question)-->
                        }
                    </RadzenStack>
                </RadzenCard>
                <RadzenCard Style="width:700px;">
                    <RadzenImage Path="@quizFoto" Style="width:100%; height:auto;"></RadzenImage>
                </RadzenCard>
            </RadzenStack>
        </Template>
    </RadzenDataList>
    @if (QuestionsList != null && barValue == QuestionsList.Count() && (QuestionsList.All(x => x.selectedAnswer != null || (x.selectMultiAnswers != null && x.selectMultiAnswers.Count > 0) || (filledAnswersInGaps.Where(y => y.Key.QuestionId == x.Id).Count() == x.GapFields.Count()))) && !quizDone)
    {
        <RadzenButton Variant="Variant.Flat" Text="Abgeben" Click="QuizAccomplisched" ButtonStyle="ButtonStyle.Success" />
    }
    @if (quizDone)
    {
        <CompletedQuizMessage PlayerPoints="playerPoints"
                              CollectedPointsFromPlayer="collectedPointsFromPlayerPerQuiz"
                              QuestionSetId="QuestionSetId"
                              SpielerId="SpielerId"
                              ThemaId="ThemaId"
                              CharacterId="CharacterId"
                              OnRetryWrong="ReloadWrongQuestions">
        </CompletedQuizMessage>
    }

    <RadzenStack Gap="1rem" class="rz-m-12">
        <RadzenProgressBar Value="@barValue" Max="QuestionsList.Count" Unit=@(" out of " + QuestionsList.Count) AriaLabel="Upload progress" />
    </RadzenStack>
}


@code {
    [Parameter] public int SpielerId { get; set; }
    [Parameter] public int QuestionSetId { get; set; }
    [Parameter] public int ThemaId { get; set; }
    [Parameter] public int CharacterId { get; set; }

    private string BackgroundImage; //set in OnParametersSetAsync

    RadzenDataList<Question>? dataList;
    List<Question> QuestionsList = new();
    List<Question> wrongAnsweredQuestions = new();

    HashSet<int> answeredQuestions = new HashSet<int>();
    double barValue = 0;

    int? collectedPointsFromPlayerPerQuiz = 0;

    int playerPoints = 0;
    Dictionary<int, int> pointsPerQuestion = new Dictionary<int, int>();
    string pageTitle = "";
    string quizFoto = "";

    bool quizDone = false;

    McAnswer? selectedSingleChoiceAnswer;
    HashSet<int> previousSelectedMultipleAnswerIDs = new HashSet<int>();
    Dictionary<(int QuestionId, int GapIndex), bool> filledGapsInQuestionWithStates = new();
    Dictionary<(int QuestionId, int GapIndex), string> filledAnswersInGaps = new();

    protected override async Task OnParametersSetAsync()
    {

        //set image for the background, if exists, otherwise set default image
        var imagePath = $"/images/Themen/Theme_Image_{ThemaId}.png";
        var physicalPath = Path.Combine(Env.WebRootPath, "images", "Themen", $"Theme_Image_{ThemaId}.png");

        if (File.Exists(physicalPath))
        {
            BackgroundImage = imagePath;
        }
        else
        {
            BackgroundImage = "/images/Themen/Theme_Image_0.png";
        }

        quizDone = false;
        barValue = 0;
        answeredQuestions = new();
        pointsPerQuestion = new();
        previousSelectedMultipleAnswerIDs = new();
        filledAnswersInGaps = new();
        filledGapsInQuestionWithStates = new();
        wrongAnsweredQuestions = new();

        await determinQuizData();

        foreach (var question in QuestionsList)
        {
            question.selectedAnswer = null;
        }

        StateHasChanged();

        if (dataList != null)
        {
            await dataList.FirstPage(true);  // show first question
        }
    }

    async Task determinQuizData()
    {
        QuestionSet questionSet = await loadQuestionSet(QuestionSetId);

        pageTitle = questionSet.Title;
        await loadData(QuestionSetId);

        quizFoto = "/images/" + $"{QuestionSetId}.png";

        if (quizFoto is null || string.IsNullOrWhiteSpace(quizFoto))
        {
            quizFoto = "/images/demo.png";
        }
    }

    async Task loadData(int questionSetId)
    {
        QuestionsList = (await questionService.GetAllEntriesByQuestionSetIncludingNavigationsAsync(questionSetId)).ToList();
        //QuestionsList = QuestionsList.Where(x => x.QuestionType == QuestionType.MC).ToList(); //TEST Multiple Choice only
        //QuestionsList = QuestionsList.Where(x => x.QuestionType == QuestionType.TF).ToList(); //TEST Single Choice only
        //QuestionsList = QuestionsList.Where(x => x.QuestionType == QuestionType.GAP).ToList(); //TEST Gap Text only
    }

    async Task<QuestionSet> loadQuestionSet(int questionSetId)
    {
        QuestionSet questionSet = await questionSetService.GetEntryByKeyIncludingNavigationsAsync(questionSetId);
        return questionSet;
    }

    async Task QuizAccomplisched()
    {
        foreach (var questionId in pointsPerQuestion)
        {
            if (questionId.Value < 0)
                playerPoints += 0;
            else 
                playerPoints += questionId.Value; //add Multiple Choice points to whole player points
        }

        QuestionSet questionSet = await questionSetService.GetEntryByKeyIncludingNavigationsAsync(QuestionSetId);
        string topic = questionSet.Title;

        double MaxPoints = getMaxPointsForQuiz(questionSet);
        double halfPoints = MaxPoints / 2;


        collectedPointsFromPlayerPerQuiz = playerPoints - QuizStateService.FinalCollected;

        bool passed = collectedPointsFromPlayerPerQuiz >= halfPoints;

        if (passed)
        {

            var progress = new QuestionSetProgress
            {
                Topic = topic,
                SpielerId = SpielerId,
                ThemaId = ThemaId,
                CharacterId = CharacterId,
                QuestionSetId = QuestionSetId,
                Points = collectedPointsFromPlayerPerQuiz,
                MaxPoints = MaxPoints,
                IsPassed = passed
            };

            await QestionSetProgressService.AddEntryAsync(progress);

            QuizStateService.FinalCollected = playerPoints;
        }

        quizDone = true;
    }

    private int getMaxPointsForQuiz(QuestionSet questionSet)
    {
        int max = 0;

        foreach (var q in questionSet.Questions)
        {
            max += q.McAnswers.Where(a => a.IsCorrect).Sum(a => a.Points); //Count points of correct answer per question (1 for Single, 0 for Gaps)
            max += q.GapFields.Count(); //Count number of gap fields per question (0 if Multiple/Single)
        }

        return max;
    }

    public async Task ReloadWrongQuestions()
    {
        if (wrongAnsweredQuestions.Any())
        {
            foreach (var question in QuestionsList)
            {
                if (question.QuestionType == QuestionType.MC && wrongAnsweredQuestions.Contains(question) && (pointsPerQuestion.ContainsKey(question.Id) ? pointsPerQuestion[question.Id] > 0 : false))
                {
                    playerPoints -= pointsPerQuestion[question.Id]; //for Multiple Choice: remove given points for wrong question (negative value skipped, they are not added previously anyway)
                }
                question.selectMultiAnswers.Clear(); //reset checked box
            }
            pointsPerQuestion.Clear(); //reset all gained Points; evalaluation should start all over again
            previousSelectedMultipleAnswerIDs.Clear();//reset selected Answers; Muliple choice evalaluation should start all over again
            filledAnswersInGaps.Clear();
            filledGapsInQuestionWithStates.Clear();

            QuestionsList = wrongAnsweredQuestions.ToList();

            foreach (var question in QuestionsList)
            {
                question.selectedAnswer = null; // reset answers
            }

            barValue = 0;
            answeredQuestions.Clear();
            wrongAnsweredQuestions.Clear();
            quizDone = false;

            await InvokeAsync(StateHasChanged);

            if (dataList != null)
            {
                await dataList.FirstPage(true);  // show first wrong question
            }
        }
    }
    #region SingleChoice
    /// <summary>
    /// Single Choice Evaluating
    /// </summary>
    /// <param name="value"></param>
    /// <param name="question"></param>
    /// <author>Samer</author>
    void SinglechoiceEvaluating(McAnswer value, Question question)
    {
        if (value is null)
            return;

        if (value.IsCorrect)
        {
            handleAddPoints(question.Id, value.Points);
            if (wrongAnsweredQuestions.Contains(question))
            {
                wrongAnsweredQuestions.Remove(question);
            }
        }
        else
        {
            if (!wrongAnsweredQuestions.Contains(question))
            {
                wrongAnsweredQuestions.Add(question);
            }
        }

        if (!answeredQuestions.Contains(question.Id))
        {
            barValue++;
            answeredQuestions.Add(question.Id);
        }
    }
    #endregion

    #region MultipleChoice
    /// <summary>
    /// Collect all checked boxes in a list and execute the evaluation
    /// </summary>
    /// <param name="question"></param>
    /// <param name="value"></param>
    /// <author>Maxim</author>
    private void OnChangeMultipleChoice(Question question, IEnumerable<McAnswer> value)
    {
        question.selectMultiAnswers = value?.ToList() ?? new List<McAnswer>();
        MultiplechoiceEvaluating(value, question);
    }

    /// <summary>
    /// Multiple Choice Evaluating
    /// </summary>
    /// <param name="selectedAnswers"></param>
    /// <param name="question"></param>
    /// <author>Maxim</author>
    void MultiplechoiceEvaluating(IEnumerable<McAnswer>? selectedAnswers, Question question)
    {
        int points = 0;
        bool hasWrong = false;
        if (selectedAnswers == null)
            return;

        foreach (var answerOptions in question.McAnswers)
        {
            //Option was checked now
            if (!previousSelectedMultipleAnswerIDs.Contains(answerOptions.Id) && selectedAnswers.Any(sA => sA.Id == answerOptions.Id))
            {
                previousSelectedMultipleAnswerIDs.Add(answerOptions.Id); //memorize that answer was selected
                if (answerOptions.IsCorrect)
                    points += answerOptions.Points;
                else
                {
                    points -= answerOptions.Points;
                    hasWrong = true;
                }

            }
            //Option was unchecked now
            else if (previousSelectedMultipleAnswerIDs.Contains(answerOptions.Id) && !selectedAnswers.Any(sA => sA.Id == answerOptions.Id))
            {
                previousSelectedMultipleAnswerIDs.Remove(answerOptions.Id); //remove memorize that answer was selected
                //reverse points
                if (answerOptions.IsCorrect)
                {
                    points -= answerOptions.Points;
                    hasWrong = true;
                }
                else
                    points += answerOptions.Points;
            }
            //Option is correct, but not checked by the player
            else if (!selectedAnswers.Any(sA => sA.Id == answerOptions.Id) && answerOptions.IsCorrect)
                hasWrong = true;
            //Option is false, but checked by the player
            else if (selectedAnswers.Any(sA => sA.Id == answerOptions.Id) && !answerOptions.IsCorrect)
                hasWrong = true;

        }

        handleAddPoints(question.Id, points);

        //player has selected a wrong answer or not all correct answer
        if (hasWrong && !wrongAnsweredQuestions.Contains(question))
            wrongAnsweredQuestions.Add(question);
        else if (!hasWrong && wrongAnsweredQuestions.Contains(question))
            wrongAnsweredQuestions.Remove(question);

        if (!answeredQuestions.Contains(question.Id))
        {
            barValue++;
            answeredQuestions.Add(question.Id);
        }
    }
    #endregion

    #region GapText

    /// <summary>
    ///  Part Class to split Question Text in normal Text and Gaps which should be replaced with Textareas
    /// </summary>
    /// <author>Maxim</author>
    public class TextPart
    {
        public string? Text { get; set; }
        public bool IsGap { get; set; }
        public int GapIndex { get; set; }
    }

    /// <summary>
    /// Split Question Text between the Gaps to enable Textarea
    /// </summary>
    /// <param name="text"></param>
    /// <author>Maxim</author>
    List<TextPart> SplitGapQuestionText(string? text)
    {
        var result = new List<TextPart>();
        if (!string.IsNullOrEmpty(text))
        {
            var parts = Regex.Split(text, "(_{2,})");
            int gapIndex = 0;

            foreach (var p in parts)
            {
                if (Regex.IsMatch(p, "_{2,}"))
                {
                    result.Add(new TextPart { IsGap = true, GapIndex = gapIndex });
                    gapIndex++;
                }
                else
                    result.Add(new TextPart { Text = p });
            }
        }

        return result;
    }

    /// <summary>
    ///    Get the value for textarea (needed when Player "returns" to the question)
    /// </summary>
    /// <param name="questionId"></param>
    /// <param name="gapIndex"></param>
    /// <returns></returns>
    string GetGapValue(int questionId, int gapIndex)
    {
        if (filledAnswersInGaps.TryGetValue((questionId, gapIndex), out var value))
            return value;

        return "";
    }

    /// <summary>
    /// Gap Text Evaluating
    /// </summary>
    /// <param name="value">Text the user types in</param>
    /// <param name="question"></param>
    /// <author>Maxim</author>
    void GapTextEvaluation(String value, Question question, int gapIndex)
    {
        filledAnswersInGaps[(question.Id, gapIndex)] = value;
        //the gap is empty/null
        if (string.IsNullOrEmpty(value)) {
            if (filledGapsInQuestionWithStates.ContainsKey((question.Id, gapIndex)))
            {
                filledGapsInQuestionWithStates.Remove((question.Id, gapIndex)); //removes the gap filled mark
                if (answeredQuestions.Contains(question.Id))
                {
                    barValue--;
                    answeredQuestions.Remove(question.Id);
                }
            }
            return;
        }

        if (!filledGapsInQuestionWithStates.ContainsKey((question.Id, gapIndex)))
        {
            filledGapsInQuestionWithStates[(question.Id, gapIndex)] = false; //mark that the gap was filled
        }

        if (question.GapFields.Any(a => a.GapIndex == gapIndex && !String.IsNullOrEmpty(a.CorrectText) ? a.CorrectText.Equals(value, a.CaseSensitive ? StringComparison.OrdinalIgnoreCase : StringComparison.Ordinal) : false))
        {
            //correct gapIndex and answer text
            handleAddPoints(question.Id, 1);
            filledGapsInQuestionWithStates[(question.Id, gapIndex)] = true;
            if (filledGapsInQuestionWithStates.Where(x => x.Key.QuestionId == question.Id).Count() == question.GapFields.Count() && filledGapsInQuestionWithStates.Where(x => x.Key.QuestionId == question.Id).All(x => x.Value))
                wrongAnsweredQuestions.Remove(question); //all gaps for this question were answered and are correct -> remove wrong question marker
        }
        else
        {
            if (!wrongAnsweredQuestions.Contains(question))
                wrongAnsweredQuestions.Add(question);
            if (pointsPerQuestion.ContainsKey(question.Id) && filledGapsInQuestionWithStates.TryGetValue((question.Id, gapIndex), out bool gapState))
            {
                if (gapState == true)
                    handleAddPoints(question.Id, -1);  //Remove previously given point for that gap
            }
            filledGapsInQuestionWithStates[(question.Id, gapIndex)] = false;
        }

        //also validates, if all gaps were answered
        if (!answeredQuestions.Contains(question.Id) && filledGapsInQuestionWithStates.Where(x => x.Key.QuestionId == question.Id).Count() == question.GapFields.Count())
        {
            barValue++;
            answeredQuestions.Add(question.Id);
        }
    }


#endregion

    /// <summary>
    /// support class to add points correctly
    /// </summary>
    /// <param name="questionKey"></param>
    /// <param name="pointValue"></param>
    void handleAddPoints(int questionKey, int pointValue)
    {
        if (pointsPerQuestion.ContainsKey(questionKey))
            pointsPerQuestion[questionKey] = pointsPerQuestion[questionKey] + pointValue;
        else
            pointsPerQuestion.Add(questionKey, pointValue);
    }
}
