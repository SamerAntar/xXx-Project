@page "/PageSingleChoice"
@page "/PageSingleChoice/{SpielerId:int}"
@inject NavigationManager Navi


<h3>PageSingleChoice</h3>


<h5>Hi ich bin Samer und werde ich das im Nachgang weitermachen !!!</h5>

<RadzenButton Variant="Variant.Flat" Click="@GoToNextPage" Text="Lets Go :)" ButtonStyle="ButtonStyle.Success" />

@code {

    [Parameter]
    public int? SpielerId { get; set; }


    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();

    }

    private void GoToNextPage()
    {
        if (SpielerId == null)
            return;

        //Todo:  Edge Cases testen (z. B. ungültige oder fehlende Character-ID).
        // Es sollte verhindert werden zu navigieren wenn der ID von Spieler nicht in der Datenbank gespeichert. Und NotificationMessage anzeigen. ich brauche aber die Datenbank zuerst. :)
        // NotificationService.Notify(new NotificationMessage { Severity = NotificationSeverity.Info, Summary = "ID nicht existiert", Detail = text });

        Navi.NavigateTo($"/PageTrueFalseChoice/{SpielerId}");
    }
}
