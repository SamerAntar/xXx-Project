@using Schulprojekt.Data
@using Schulprojekt.Services
@inject IQuestionSetService questionSetService
@inject NotificationService NotificationService
@inject QuizStateService quizStateService
@inject NavigationManager Navi

<RadzenCard class="completed-card rz-shadow-4 rz-p-6">
    <RadzenStack AlignItems="AlignItems.Center" Gap="1.5rem">
        @if (CollectedPointsFromPlayer >= halfQuizPoints)
        {
            <RadzenImage Path="/images/Satotz_correct.png"  />
            <RadzenIcon Icon="emoji_events" Style="font-size:64px;color:#4caf50;" />
            <h2>Gut gemacht!</h2>
            <h5>Du hast genug Punkte in dieser Prüfung gesammelt, um weiterzukommen.</h5>

            <RadzenButton Text="Nächste Prüfung starten"
                          Click="GoToNextQuiz"
                          Icon="arrow_forward"
                          ButtonStyle="ButtonStyle.Success"
                          Style="margin-top:1rem" />
        }
        else
        {
            <RadzenImage Path="/images/Satotz_wrong.png" />
            <RadzenIcon Icon="sentiment_neutral" Style="font-size:64px;color:#f44336;" />

            <h2>Du hast noch nicht genug Punkte gesammelt.</h2>
            <h5>Bitte absolviere die Prüfung nochmal und versuche, deine falschen Antworten zu korrigieren.</h5>

            <RadzenButton Text="Falsch beantwortete Fragen wiederholen"
                          Click="@(() => OnRetryWrong.InvokeAsync())"
                          Icon="arrow_back"
                          ButtonStyle="ButtonStyle.Danger"
                          Style="margin-top:1rem" />
        }
    </RadzenStack>
</RadzenCard>


<style>
    .completed-card {
        max-width: 520px;
        margin: 5rem auto;
        border-radius: 16px;
        /* Start-Zustand */
        opacity: 0;
        transform: scale(0.95);
        /* Animation über Transition */
        transition: opacity 0.6s ease, transform 0.6s ease;
        /* Optik */
        background: linear-gradient(145deg, #ffffff, #f3f6f9);
    }

    /* Wird automatisch aktiv, sobald gerendert */
    .completed-card {
        opacity: 1;
        transform: scale(1);
    }

</style>



@code {

    [Parameter] public int? PlayerPoints { get; set; }
    [Parameter] public int QuestionSetId { get; set; }
    [Parameter] public int? SpielerId { get; set; }
    [Parameter] public int ThemaId { get; set; }
    [Parameter] public int CharacterId { get; set; }
    [Parameter] public int? CollectedPointsFromPlayer { get; set; }

    [Parameter] public EventCallback OnRetryWrong { get; set; }

    double halfQuizPoints;

    List<QuestionSet> questionSets = new();

    HashSet<int> questionSetsIds = new HashSet<int>();

    protected override async Task OnInitializedAsync()
    {
        if (!quizStateService.IsInitialized)
        {
            questionSets = (await questionSetService.GetAllEntriesIncludingNavigationsAsync()).ToList();

            quizStateService.RemainingQuizIds = questionSets
                                                .Where(q => q != null)
                                                .Select(q => q!.Id)
                                                .ToHashSet();

            quizStateService.IsInitialized = true;

        }

        quizStateService.RemainingQuizIds.Remove(QuestionSetId); // Remove Last Quiz so i can start the next one.

        var questionSet = await questionSetService.GetEntryByKeyIncludingNavigationsAsync(QuestionSetId);

        double MaxPoints = getMaxPointsForQuiz(questionSet);

        halfQuizPoints = MaxPoints / 2;
    }

    private void GoToNextQuiz()
    {
        if (quizStateService.RemainingQuizIds.Any())
        {
            int nextQuizId = quizStateService.RemainingQuizIds.First();
            quizStateService.RemainingQuizIds.Remove(nextQuizId);

            Navi.NavigateTo($"/Quiz/ThemaID={ThemaId}/CharacterId={CharacterId}/SpielerID={SpielerId}/QuizID={nextQuizId}");
        }
        else
        {
            Navi.NavigateTo($"/FinalResults/CharacterId={CharacterId}/SpielerID={SpielerId}/QuestionSetID={QuestionSetId}");
            //NotificationService.Notify(new NotificationMessage { Severity = NotificationSeverity.Info, Summary = "Kein weiteres Quiz", Duration = 3000 });
        }
    }

    private int getMaxPointsForQuiz(QuestionSet questionSet)
    {
        int points = 0;

        foreach (var q in questionSet.Questions)
        {
            points += q.McAnswers.Where(x => x.IsCorrect).Sum(x => x.Points);

            points += q.GapFields.Count();
        }

        return points;
    }
}
