@page "/"
@using Schulprojekt.Data
@using Schulprojekt.Services
@inject ISpielerService spielerService;
@inject IRaumService raumService;
@inject NotificationService NotificationService
@inject NavigationManager Navi
<div class="home-background">
    <div class="home-content">
        <PageTitle>Home</PageTitle>

        <h1>Hello, Boys!</h1>

        <h2>Welcome to Hunter X Hunter Game.</h2>

        <div style="width:300px; margin: 5mm;">
            <RadzenLabel> Select a Player</RadzenLabel>
            <RadzenDropDown Placeholder="--Select a Player--" AllowClear="true"
                            TValue="Spieler"
                            Data="@players"
                            TextProperty="Name"
                            @bind-Value="selectedPlayer"
                             />
            @if (IsPlayerMissing())
            {
                <RadzenAlert AlertStyle="AlertStyle.Warning" AllowClose="false"
                             Size="AlertSize.ExtraSmall" Variant="Variant.Flat" Shade="Shade.Dark"
                             Style="width:75%">
                    Player should be chosen!
                </RadzenAlert>
            }
        </div>

        <div style="width:300px; margin: 5mm;">
            <RadzenLabel> Select a Room</RadzenLabel>
            <RadzenDropDown Placeholder="--Select a Room--" AllowClear="true"
                            TValue="Raum"
                            Data=@rooms
                            @bind-Value="selectedRoom"
                            TextProperty="Name" />
            @if (IsRoomMissing())
            {
                <RadzenAlert Style="width:75%" AllowClose="false" AlertStyle="AlertStyle.Warning"
                             Size="AlertSize.ExtraSmall" Variant="Variant.Flat">
                    Room should be chosen!
                </RadzenAlert>
            }
        </div>


        <RadzenButton Variant="Variant.Flat" Click="@GoToNextPage" Text="Lets Go :)" ButtonStyle="ButtonStyle.Success" />
    </div>
</div>




@code {
    List<Spieler> players = new();
    List<Raum> rooms = new();

    Raum? selectedRoom;
    Spieler? selectedPlayer;

    protected override async Task OnInitializedAsync()
    {
        rooms = await raumService.GetAllRooms();
        players = await spielerService.GetAllPlayers();
    }

    void OnPlayerChanged(object value)
    {
        var name = value as string;

        if (string.IsNullOrEmpty(name))
        {
            selectedPlayer = null;
            return;
        }

        selectedPlayer = new Spieler
        {
            Name = name
        };
    }

    private bool IsPlayerMissing() => string.IsNullOrEmpty(selectedPlayer?.Name);
    private bool IsRoomMissing() => selectedRoom is null;

    private void GoToNextPage()
    {
         if (selectedPlayer == null)
             return;

        //Todo:  Edge Cases testen (z. B. ungültige oder fehlende Character-ID). 
        // Es sollte verhindert werden zu navigieren wenn der ID von Spieler nicht in der Datenbank gespeichert. Und NotificationMessage anzeigen. ich brauche aber die Datenbank zuerst. :)
       // NotificationService.Notify(new NotificationMessage { Severity = NotificationSeverity.Info, Summary = "ID nicht existiert", Detail = text });
        
       Navi.NavigateTo($"/PageSingleChoice/{selectedPlayer?.Id}");
    }
}
