@page "/"
@using Schulprojekt.Data
@using Schulprojekt.Services
@inject ISpielerService SpielerService
@inject IQuestionSetService QuestionSetService
@inject IThemaService ThemaService
@inject NotificationService NotificationService
@inject NavigationManager Navi

<PageTitle>Homepage</PageTitle>

<div class="home-background" style="background-image: url('/images/HomeMain.png')">
    <div class="home-content">
        <h2>Willkommen beim Hunter X Hunter Spiel</h2>
        <div style="display:flex; justify-content:center; margin-top:40px;">
            <div style="width:300px;">
                <!-- #Row 1 DropdownList (Themen) -->
                <RadzenDropDown AllowClear="false"
                                Placeholder="--Bitte Thema auswählen--"
                                TValue="Thema"
                                Data="@ThemenList"
                                TextProperty="Name"
                                @bind-Value="selectedthema"
                                Change="LoadQuestionSet" />
                @if (IsThemeMissing())
                {
                    <RadzenAlert AlertStyle="AlertStyle.Warning" AllowClose="false"
                                 Size="AlertSize.ExtraSmall" Variant="Variant.Flat" Shade="Shade.Dark"
                                 Style="width:90%">
                        Thema ist erforderlich!
                    </RadzenAlert>
                }
            </div>
        </div>
        <div style="display:flex; justify-content:center; margin-top:20px;">
            <div style="width:300px;">
                <!-- #Row 2 DropdownList (Spielers) -->
                <RadzenDropDown AllowClear="true"
                                Placeholder="--Bitte Spieler auswählen--"
                                TValue="Spieler"
                                Data="@SpielerList"
                                TextProperty="Name"
                                @bind-Value="selectedPlayer" />
                @if (IsPlayerMissing())
                {
                    <RadzenAlert AlertStyle="AlertStyle.Warning" AllowClose="false"
                                 Size="AlertSize.ExtraSmall" Variant="Variant.Flat" Shade="Shade.Dark"
                                 Style="width:90%">
                        Spieler ist erforderlich!
                    </RadzenAlert>
                }
            </div>
            <div style="width:300px;">
                <!-- #Row 2 DropdownList (QuestionSet) -->
                <RadzenDropDown Placeholder="--Bitte Quiz auswählen--"
                                AllowClear="true"
                                TValue="QuestionSet"
                                Data="@QuestionSetsList"
                                TextProperty="Title"
                                @bind-Value="selectedQuestionSet" />
                @if (IsQuestionSetMissing())
                {
                    <RadzenAlert AlertStyle="AlertStyle.Warning" AllowClose="false"
                                 Size="AlertSize.ExtraSmall" Variant="Variant.Flat" Shade="Shade.Dark"
                                 Style="width:85%">
                        Quiz ist erforderlich!
                    </RadzenAlert>
                }
            </div>
        </div>     
        <div style="display:flex; justify-content:center; margin-top:40px;">
            <RadzenButton Variant="Variant.Flat" Click="GoQuizPage" Text="Quiz starten" ButtonStyle="ButtonStyle.Success" />
        </div>
    </div>
    <RadzenImage Path="/images/Hisokaaa.png"
                 Style="position:absolute;
                        bottom:20px;
                        right:20px;
                        width:300px;
                        height:auto;" />

</div>


@code {

    List<Spieler> SpielerList = new();
    List<QuestionSet> QuestionSetsList = new();
    List<Thema> ThemenList = new();
    Spieler? selectedPlayer;
    QuestionSet? selectedQuestionSet;
    Thema? selectedthema;


    protected override async Task OnInitializedAsync()
    {
        SpielerList = (await SpielerService.GetAllPlayers()).ToList();
        ThemenList = (await ThemaService.GetAllEntriesIncludingNavigationsAsync()).ToList();
    }

    /// <summary>
    /// Player Validation.
    /// </summary>
    /// <returns></returns>
    private bool IsPlayerMissing() => string.IsNullOrEmpty(selectedPlayer?.Name);

    /// <summary>
    /// QuestionSet Validation.
    /// </summary>
    /// <returns></returns>
    private bool IsQuestionSetMissing() => string.IsNullOrEmpty(selectedQuestionSet?.Title);

    /// <summary>
    /// QuestionSet Validation.
    /// </summary>
    /// <returns></returns>
    private bool IsThemeMissing() => string.IsNullOrEmpty(selectedthema?.Name);

    /// <summary>
    /// Navigate to the
    /// </summary>
    private void GoQuizPage()
    {
        if (selectedPlayer is null || selectedQuestionSet is null)
        {
            NotificationService.Notify(new NotificationMessage 
                { 
                    Severity = NotificationSeverity.Info, 
                    Summary = "Fehlende Eingaben", 
                    Detail = "bitte Thema, Spieler und Quiz auswählen" });

            return;
        }

        Navi.NavigateTo($"/Quiz/SpielerID={selectedPlayer.Id}/QuizID={selectedQuestionSet.Id}");
    }

    async Task LoadQuestionSet()
    {
        if (selectedthema is not null)
        {
            QuestionSetsList = (await QuestionSetService.GetEntriesByThemaKeyIncludingNavigationsAsync(selectedthema.Id)).ToList();
        }
        else
        {
            QuestionSetsList.Clear();
        }
    }
}
