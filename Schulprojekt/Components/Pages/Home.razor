@page "/"
@using Schulprojekt.Data
@using Schulprojekt.Services
@inject ISpielerService SpielerService
@inject NotificationService NotificationService
@inject NavigationManager Navi
@inject DialogService DialogService

<PageTitle>Homepage</PageTitle>

<div class="home-background" style="background-image: url('/images/StartBackground.png')">
    <div class="home-content">
        <RadzenStack>
            <RadzenStack AlignItems="AlignItems.Center">
                <RadzenRow>
                    <RadzenImage Style="
                        margin-top:-60px;
                        width:700px;
                        height:auto;"
                                 Path="/images/Logo.png">
                    </RadzenImage>
                </RadzenRow>
            </RadzenStack>
            <RadzenStack AlignItems="AlignItems.Center">
                <RadzenRow>
                    <RadzenText Style="text-align:center; font-weight:bold; color:black; background-color:lightgray; padding:6px; border-radius: 4px; opacity: 0.7;">
                        Willkommen beim IHKunterxIHKunter Spiel!<br />
                        Helfen Sie Gon und seinen Freunden, die IHKunter Lizenz zu erwerben! <br />
                        Bitte geben Sie ihren Spielernamen ein, um ihre alten Spieldaten zu laden oder einen neuen Spielstand zu erstellen.
                    </RadzenText>
                </RadzenRow>
            </RadzenStack>
            <RadzenStack AlignItems="AlignItems.Center">
                <RadzenRow AlignItems="AlignItems.Center">
                    <RadzenTextBox Style="width:250px;"
                                   @bind-Value="playerName"
                                   Change="@(() => IsPlayerExist(playerName))"
                                   Placeholder="Spielername eingeben" />
                </RadzenRow>
                <RadzenRow>

                    @if (IsPlayerMissing())
                    {
                        <RadzenAlert Style="width:250px;"
                                     AlertStyle="AlertStyle.Warning"
                                     AllowClose="false"
                                     Size="AlertSize.ExtraSmall"
                                     Variant="Variant.Flat"
                                     Shade="Shade.Dark">
                            Spieler ist erforderlich!
                        </RadzenAlert>
                    }
                </RadzenRow>
            </RadzenStack>
            <RadzenStack AlignItems="AlignItems.Center">
                <RadzenRow>
                    <RadzenButton Variant="Variant.Filled"
                                  Click="StartGame"
                                  Text="Spiel starten"
                                  ButtonStyle="ButtonStyle.Success" />
                </RadzenRow>
            </RadzenStack>
        </RadzenStack>
    </div>

</div>


@code {


    string playerName = "";

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
    }

    /// <summary>
    /// Player Validation.
    /// </summary>
    /// <returns></returns>
    private bool IsPlayerMissing() => string.IsNullOrWhiteSpace(playerName);

    /// <summary>
    /// Navigate to the
    /// </summary>
    async Task StartGame()
    {
        if (string.IsNullOrWhiteSpace(playerName))
        {
            NotificationService.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Info,
                Summary = "Fehlende Eingaben",
                Detail = "Bitte Spieler eingeben!"
            });

            return;
        }

        Spieler? player = new();

        if (await IsPlayerExist(playerName))
        {

            var start = await DialogService.Confirm(
                   ($"Für den Spielernamen {playerName} wurden bereits Speicherdaten gefunden. Wollen Sie den Spielstand {playerName} laden?"),
                   "Bestätigungsnachfrage", new ConfirmOptions { OkButtonText = ("Ja"), CancelButtonText = ("Nein") }) ?? false;

            if (start)
            {
                player = (await SpielerService.GetAllPlayers())
                        .FirstOrDefault(x => string.Equals(x.Name, playerName, StringComparison.OrdinalIgnoreCase));
            }
            else
            {
                return;
            }

        }
        else
        {

            var start = await DialogService.Confirm(
                  ($"Für den Spielernamen {playerName} wurden keine Speicherstände gefunden. Es wird ein neuer Spielstand angelegt. Ok?"),
                  "Bestätigungsnachfrage", new ConfirmOptions { OkButtonText = ("Ja"), CancelButtonText = ("Nein") }) ?? false;

            if (start)
            {
                player = new Spieler { Name = playerName };

                player = await SpielerService.AddOrUpdateAsync(player);
            }
            else
            {
                return;
            }

        }

        if (player?.Id > 0)
        {
            Navi.NavigateTo($"/MenuSeite/SpielerID={player.Id}");
        }
    }

    async Task<bool> IsPlayerExist(string playerName)
    {
        bool exist = false;

        Spieler? player = (await SpielerService.GetAllPlayers())
            .FirstOrDefault(x => string.Equals(x.Name, playerName, StringComparison.OrdinalIgnoreCase));

        if (player is not null)
            exist = true;

        var sam = 99;
        return exist;
    }
}
