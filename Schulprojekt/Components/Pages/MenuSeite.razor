@page "/MenuSeite"
@page "/MenuSeite/SpielerID={SpielerId:int}"
@using Schulprojekt.Data
@using Schulprojekt.Services
@inject IQuestionSetService QuestionSetService
@inject ICharacterService CharacterService
@inject IThemaService ThemaService
@inject NotificationService NotificationService
@inject NavigationManager Navi
@inject IWebHostEnvironment Env

<PageTitle>Homepage</PageTitle>

<div class="home-background" style="background-image: url('/images/MenuMain.png')">
    <div class="home-content">
        <h2>Willkommen beim IHKunter X IHKunter Spiel.</h2>
        <RadzenRow Orientation="Orientation.Vertical">
        <RadzenColumn Size="8">
        <RadzenRow>
            <!-- #1 Column: Characterselect -->
            <RadzenColumn Size="6" Style="padding:20px 0px ;">
                <RadzenCard  Style="height:100%; padding:15px; background-color:lightgray; padding:6px; opacity: 0.9;">
                    <div style="text-align:center; margin:15px;">
                        <RadzenText Text="Partnercharacter:" Style="font-weight:bold;" />
                        <RadzenDropDown Placeholder="--Bitte Character auswählen--" Style="width=100%"
                                    TValue="Character"
                                    Data="@CharacterList"
                                    TextProperty="Name"
                                    @bind-Value="selectedCharacter"
                                    Change="LoadCharacterProfile" />
                    </div>
                    @if (IsCharacterMissing())
                    {
                        <RadzenAlert AlertStyle="AlertStyle.Warning" AllowClose="false"
                                     Size="AlertSize.ExtraSmall" Variant="Variant.Flat" Shade="Shade.Dark">
                            Ein Character muss gewählt werden!
                        </RadzenAlert>
                        <div style="text-align:center; margin:15px;">
                            <RadzenIcon Icon="account_circle" Style="width: 100px; height: 100px; border-radius: 50%; background-color:black" />
                        </div>
                        <RadzenText Style="width:100%; margin-top:10px; height: 200px" />
                    }
                    else
                    {
                        <div style="text-align:center; margin:15px;">
                            <RadzenImage Path=@CharacterProfileImagePath Style="width: 100px; height: 100px; border-radius: 50%;" />
                        </div>
                                <RadzenText Style="width:100%; margin-top:10px; height: 200px; padding: 10px; font-weight:bold;">
                            @CharacterProfilBackstory
                        </RadzenText>
                    }
                </RadzenCard>
            </RadzenColumn>

            <!-- #2 Column: Themeselect -->
            <RadzenColumn Size="6" Style="padding:20px 0px ;">
                <RadzenCard Style="height:100%; padding:15px; background-color:lightgray; padding:6px; opacity: 0.9;">
                    <div style="text-align:center; margin:15px;">
                        <RadzenText Text="Prüfungsort:" Style="font-weight:bold;" />
                        <RadzenDropDown Placeholder="--Bitte Gebiet (Thema) auswählen--"
                                    TValue="Thema"
                                    Data="@ThemenList"
                                    TextProperty="GamePlaceName"
                                    @bind-Value="selectedThema"
                                    Change="LoadThemeInfo" />
                    </div>
                    @if (IsThemeMissing())
                    {
                        <RadzenAlert AlertStyle="AlertStyle.Warning" AllowClose="false"
                                     Size="AlertSize.ExtraSmall" Variant="Variant.Flat" Shade="Shade.Dark">
                            Ein Thema muss gewählt werden!
                        </RadzenAlert>
                         <RadzenText Style="width:100%; margin-top:10px; padding: 10px; height: 200px">
                         </RadzenText>
                    }
                    else
                    {
                        <div style="text-align:center; margin:15px;">
                                    <RadzenImage Path=@ThemeInfoImage Style="width: 200px; height: 200px; border-radius: 4px; border:4px solid black;" />
                        </div>
                                <RadzenText Style="width:100%; margin-top:10px; padding: 10px; height: 200px; font-weight:bold;">
                              @ThemeInfoDescription
                        </RadzenText>
                            
                    }
                </RadzenCard>
            </RadzenColumn>
        </RadzenRow>
        <RadzenRow Orientation="Orientation.Vertical">
            <RadzenCard Style="width:100%; height: 150px; padding:20px; background-color:lightgray; opacity: 0.9;">
                        <RadzenText Text="Prüfung:" Style="font-weight:bold;" />
                        <RadzenRow Style="max-width:100%">
                            <RadzenDropDown Placeholder="--Bitte Prüfung auswählen--"
                                        AllowClear="true"
                                        TValue="QuestionSet"
                                        Data="@QuestionSetsList"
                                        TextProperty="Title"
                                        @bind-Value="selectedQuestionSet" />
                            <RadzenButton Variant="Variant.Flat" Click="StartGame" Text="Prüfung starten" ButtonStyle="ButtonStyle.Success" />
                            @if (IsQuestionSetMissing())
                            {
                                <RadzenAlert AlertStyle="AlertStyle.Warning" AllowClose="false"
                                    Size="AlertSize.ExtraSmall" Variant="Variant.Flat" Shade="Shade.Dark">
                                     Eine Prüfung muss gewählt werden!
                                </RadzenAlert>
                            }
                        </RadzenRow>
           </RadzenCard>
        </RadzenRow>
        </RadzenColumn>
            <RadzenColumn Size="3">
                <RadzenCard Style="height:100%; padding:15px; background-color:lightgray; padding:6px; opacity: 0.9;">
                    <RadzenImage Path="/images/Satotz_menu.png" Style="width: 100%; border:4px solid black;" />
                    <RadzenText Style="font-weight:bold; width:100%; padding: 10px;">
                        Willkommen bei der IHKunter Prüfung, Teilnehmer. Ich bin Satotz, ihr Prüfer. <br />
                        Bitte wählen sie vor Beginn ihren Partner und das Prüfungssgebiet aus.<br />
                        Danach stelle ich ihnen eine Auswahl an Prüfungen vor, die sie ablegen können.<br />
                        Sie können von einer beliebigen Prüfung starten, müssen jedoch bei jeder Prüfungen mindestens 50% der Punkte erreichen.<br />
                        Nur dann erhalten sie eine Gesamtbewertung und ihre IHKunter Lizenz, basierend an ihrer erbrachten Leistung.<br />
                        Viel Erfolg!
                    </RadzenText>
                </RadzenCard>
            </RadzenColumn>
        </RadzenRow>
     </div>
 </div>
        
@code {
    [Parameter] public int SpielerId { get; set; }
    List<QuestionSet> QuestionSetsList = new();
    List<Character> CharacterList = new();
    List<Thema> ThemenList = new();
    QuestionSet? selectedQuestionSet;
    Character selectedCharacter;
    Thema selectedThema;
    string CharacterProfileImagePath = $"/images/Profil_Images/Profil_Image_0.png";
    string CharacterProfilBackstory = "Dieser Character ist so mysteriös, dass er keine Backstory hat!";
    string ThemeInfoImage = "";
    string ThemeInfoDescription = "";

    /// <author>Samer</author>
    /// <summary>
    /// Initializes the component by asynchronously loading the list of characters and themes.
    /// Filters out any theme with an ID of 0.
    /// </summary>
    /// <returns>A task that represents the asynchronous operation.</returns>
    protected override async Task OnInitializedAsync()
    {
        CharacterList = (await CharacterService.GetAllEntriesAsync()).ToList();
        ThemenList = (await ThemaService.GetAllEntriesIncludingNavigationsAsync()).Where(x => x.Id != 0).ToList();
    }

    /// <author>Samer</author>
    /// <summary>
    /// Checks whether a character is selected by validating the character's name.
    /// </summary>
    /// <returns>
    /// True if no character is selected or the name is empty; otherwise, false.
    /// </returns>
    private bool IsCharacterMissing() => string.IsNullOrEmpty(selectedCharacter?.Name);

    /// <author>Samer</author>
    /// <summary>
    /// Checks whether a question set is selected by validating its title.
    /// </summary>
    /// <returns>
    /// True if no question set is selected or the title is empty; otherwise, false.
    /// </returns>
    private bool IsQuestionSetMissing() => string.IsNullOrEmpty(selectedQuestionSet?.Title);

    /// <author>Samer</author>
    /// <summary>
    /// Checks whether a theme is selected by validating the theme name.
    /// </summary>
    /// <returns>
    /// True if no theme is selected or the theme name is empty; otherwise, false.
    /// </returns>
    private bool IsThemeMissing() => string.IsNullOrEmpty(selectedThema?.Name);
   
    /// <author>Samer</author>
    /// <summary>
    /// Starts the quiz by navigating to the quiz page if all required selections
    /// (character, topic, and question set) are provided. Displays a notification
    /// if any required selection is missing.
    /// </summary>
    void StartGame()
    {
        if (selectedCharacter is null || selectedThema is null || selectedQuestionSet is null)
        {
            NotificationService.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Info,
                Summary = "Quiz kann noch nicht gestartet werden",
                Detail = "Bitte Character, Themengebiet und Prüfung auswählen"
            });

            return;
        }

        Navi.NavigateTo($"/Quiz/ThemaID={selectedThema.Id}/CharacterId={selectedCharacter.CharacterID}/SpielerID={SpielerId}/QuizID={selectedQuestionSet.Id}");
    }

    /// <summary>
    ///  Load Character Data after selecting a Character.
    /// </summary>
    /// <returns></returns>
    /// <author>Maxim</author>
    async Task LoadCharacterProfile()
    {
        var physicalPath = Path.Combine(Env.WebRootPath, "images", "Profil_Images", $"Profil_Image_{selectedCharacter.CharacterID}.png");
        if (File.Exists(physicalPath))
        {
            CharacterProfileImagePath = $"/images/Profil_Images/Profil_Image_{selectedCharacter.CharacterID}.png";
            CharacterProfilBackstory = $"{selectedCharacter.Backstory}";
        }
        else
        {
            CharacterProfileImagePath = $"/images/Profil_Images/Profil_Image_0.png";
            CharacterProfilBackstory = "Dieser Character ist so mysteriös, dass nur der beste Detektiv seine Identität kennt!";
        }
    }

    /// <summary>
    ///  Load Theme Data after selecting a Theme.
    /// </summary>
    /// <returns></returns>
    /// <author>Maxim</author>
    async Task LoadThemeInfo()
    {
        //set image for the background, if exists, otherwise set default image
        var imagePath = $"/images/Themen/Theme_Image_{selectedThema.Id}.png";
        var physicalPath = Path.Combine(Env.WebRootPath, "images", "Themen", $"Theme_Image_{selectedThema.Id}.png");

        if (File.Exists(physicalPath))
        {
            ThemeInfoImage = imagePath;
            ThemeInfoDescription = $"{selectedThema.GamePlaceDescription} \n\n(Thema: {selectedThema.Name})";
        }
        else
        {
            ThemeInfoImage = "/images/Themen/Theme_Image_0.png";
            ThemeInfoDescription = "Die Herausforderungen dieses Gebietes sind selbst für die IHKunter Organisation unbekannt";
        }
        await LoadQuestionSet();
    }

    async Task LoadQuestionSet()
    {
        selectedQuestionSet = null; //reset selected question set, so the user has to select a new one after changing the theme
        if (selectedThema is not null)
        {
            QuestionSetsList = (await QuestionSetService.GetEntriesByThemaKeyIncludingNavigationsAsync(selectedThema.Id)).ToList();
            if (QuestionSetsList.Count == 0)
                QuestionSetsList.Clear();
        }
        else
        {
            QuestionSetsList.Clear();
        }
    }
}

